---
// Plan du site — page standard (indexable), liens vers toutes les sections
import Base from '../../layouts/Base.astro';
import { getCategories, decodeEntities } from '../../lib/wp.mjs';

const TITLE = 'Plan du site — PDC VD';
const DESC = "Plan du site PDC VD : accueil, rubriques, contact et pages légales.";
const CANONICAL = 'https://pdc-vd.ch/plan-du-site/';

const rubriques = getCategories()
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 9);
---
<Base title={TITLE} description={DESC} canonical={CANONICAL}>
  <main class="container">
    <article class="legal-page" aria-labelledby="titre">
      <h1 id="titre">Plan du site</h1>
      <p>Retrouvez l'ensemble des rubriques et pages du site PDC VD.</p>

      <h2>Pages principales</h2>
      <ul class="plan-list">
        <li><a href="/">Accueil</a></li>
        <li><a href="/contact/">Contact — commander une publication</a></li>
      </ul>

      <h2>Rubriques</h2>
      <ul class="plan-list">
        {rubriques.map((c) => (
          <li><a href={`/#rubrique-${c.slug}`}>{decodeEntities(c.name)}</a></li>
        ))}
      </ul>

      <h2>Informations légales</h2>
      <ul class="plan-list">
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/confidentialite/">Politique de confidentialité</a></li>
        <li><a href="/cgv/">Conditions générales de vente</a></li>
      </ul>
    </article>
  </main>
</Base>

<style>
  .legal-page { max-width: 820px; margin: 24px auto 64px; }
  .legal-page h1 { font-size: 30px; margin: 0 0 14px; }
  .legal-page h2 { font-size: 19px; margin: 26px 0 10px; }
  .legal-page p { font-size: 15px; line-height: 1.7; color: #333; margin: 0 0 12px; }
  .plan-list { list-style: none; margin: 0; padding: 0; }
  .plan-list li { padding: 8px 0; border-bottom: 1px solid var(--border); }
  .plan-list a { color: var(--accent); font-weight: 600; }
</style>
